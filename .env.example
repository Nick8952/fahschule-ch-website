# Sanity — Werte aus sanity.io/manage (Projekt -> API)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Lese-Token (Rolle "Viewer"). Nur noetig, wenn das Dataset privat ist.
SANITY_API_READ_TOKEN=

# Schreib-Token (Rolle "Editor"). Nur lokal fuer `npm run seed`, NICHT in Vercel.
SANITY_API_WRITE_TOKEN=

# Frei gewaehltes Geheimnis. Muss identisch im Sanity-Webhook stehen,
# damit /api/revalidate Aenderungen sofort sichtbar macht.
SANITY_REVALIDATE_SECRET=

# Oeffentliche Adresse der Website (fuer canonical-Links und das Formular).
NEXT_PUBLIC_SITE_URL=
